# Environment Variables Template for CivicSightAI
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database Configuration (PostgreSQL with PostGIS)
POSTGRES_DB=civicsightai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email Configuration (Flask-Mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_or_email_password
ENABLE_EMAIL_NOTIFICATIONS=true

# WhatsApp Integration (Green API)
GREENAPI_ID_INSTANCE=your_green_api_instance_id
GREENAPI_API_TOKEN_INSTANCE=your_green_api_token
ENABLE_WHATSAPP_NOTIFICATIONS=false
ENABLE_GREENAPI_WHATSAPP=false

# SMS Configuration
ENABLE_SMS_NOTIFICATIONS=false

# Map Configuration
# Get your Mapbox token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token

# Development/Production Mode
FLASK_ENV=development
FLASK_DEBUG=true

# AI Model Configuration
YOLO_MODEL_PATH=yolov11_best.pt

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes
UPLOAD_FOLDER=static/uploads

# Geocoding Configuration
GEOCODING_USER_AGENT=civicsight-ai

# Map Default Settings
DEFAULT_MAP_CENTER_LAT=40.0
DEFAULT_MAP_CENTER_LNG=-74.5
DEFAULT_MAP_ZOOM=9
ENABLE_WHATSAPP_NOTIFICATIONS=false

# Instructions:
# 1. For Gmail: Enable 2-factor authentication and generate an App Password
# 2. For Twilio: Sign up at twilio.com and get your Account SID and Auth Token
# 3. For WhatsApp: Use Twilio WhatsApp sandbox for testing or get approved for production
